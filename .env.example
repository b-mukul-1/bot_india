# APEX-IN Environment Variables Example
# Copy to .env and set your credentials. Never commit secrets to git!

# MegaBull Simulator API Key (Generated at trade.megabull.in -> Profile)
MEGABULL_API_KEY=your_megabull_api_key_here

# PostgreSQL Database URL (Railway Postgres plugin provides this automatically)
DATABASE_URL=postgresql://user:password@localhost:5432/apex_in

# Security: Shared secret between Next.js dashboard server-side and FastAPI backend
API_SHARED_SECRET=generate_a_secure_random_hex_token_here

# CORS Origin of the deployed Next.js Dashboard on Vercel
DASHBOARD_ORIGIN=https://apex-in-dashboard.vercel.app

# Optional Webhook for emergency alerts (Telegram / Discord)
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Hard Safety Guard (MUST ALWAYS BE TRUE)
PAPER_MODE_ONLY=true

# Timezone (Indian Standard Time)
TZ=Asia/Kolkata
